{
  "name": "mash-data",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas Academy data pipeline for Mash",
  "scripts": {
    "atlas:start": "npm --prefix mash-atlasacademy run start",
    "atlas:combine-variants": "npm --prefix mash-atlasacademy run combine:variants",
    "atlas:build-variants": "npm --prefix mash-atlasacademy run build:variants",
    "atlas:compact-servants": "npm --prefix mash-atlasacademy run compact:servants",
    "atlas:download-runtime-skills": "npm --prefix mash-atlasacademy run download:runtime-skills",
    "atlas:combine-ces": "npm --prefix mash-atlasacademy run combine:ces",
    "atlas:combine-events": "npm --prefix mash-atlasacademy run combine:events",
    "atlas:download-event-items": "npm --prefix mash-atlasacademy run download:event-items",
    "verify:variants": "npm --prefix verification run test:servant-variants",
    "verification:generate": "npm --prefix verification run verify:all",
    "verify:variant-skill-target-types": "npm --prefix verification run verify:variant-skill-target-types",
    "data:atlas": "npm run atlas:start && npm run atlas:download-runtime-skills && npm run catalogs:generate && npm run verify:variants && npm run verification:generate",
    "verify:all": "npm --prefix verification run verify:all",
    "test:integrity": "npm --prefix verification run test:servant-variants",
    "assets:offline-base": "python3 scripts/release.py offline-base",
    "assets:deploy": "bash scripts/deploy-assets-release.sh",
    "start": "npm run data:atlas",
    "typecheck:scripts": "npm --prefix verification exec -- tsc -p tsconfig.json",
    "verify:catalogs": "npm --prefix verification run test:catalogs",
    "catalogs:generate-servants": "node scripts/generate-servants.ts",
    "catalogs:generate": "npm run atlas:build-variants && npm run atlas:combine-variants && npm run atlas:combine-ces && npm run atlas:combine-events && npm run atlas:download-event-items && npm run catalogs:generate-servants"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
